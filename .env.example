# --- OAuth / Auth (Next.js app) ---
# GitHub OAuth app (Dashboard users). Scopes are configured in lib/auth.ts (repo + admin:repo_hook, etc.).
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Server-only: HMAC secret for POST /api/webhooks/github (x-hub-signature-256).
# You generate this yourself — it is NOT from GitHub's UI. Example: openssl rand -hex 32
# Set the same value in every deployment environment. createWebhook() sends it to GitHub as config.secret;
# GitHub signs each delivery; the app verifies with timing-safe HMAC. End users never see or paste this.
GITHUB_WEBHOOK_SECRET=your_long_random_webhook_secret_here

# --- App ---
NEXT_PUBLIC_APP_BASE_URL=https://your-app-base-url.example

# --- Vector DB / Pinecone (RAG in Next + optional public Zynd RAG) ---
PINECONE_DB_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment_here

# --- LLM (Inngest PR review + Zynd agent + dashboard chat) ---
# OpenRouter: https://openrouter.ai/keys — text generation uses model qwen/qwen3.5-flash-02-23 in code.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Google AI Studio: https://aistudio.google.com/apikey — fallback + embeddings in rag.ts.
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# --- Inngest ---
INNGEST_DEV=0

# --- Zynd codereview agent (`npx zynd agent run` from repo root) ---
# Developer identity (once per machine): `npx zynd init` → ~/.zynd/developer.json
# Agent keypair: `npx zynd agent init` → ~/.zynd/agents/<name>/keypair.json
ZYND_AGENT_KEYPAIR_PATH=/home/YOUR_USER/.zynd/agents/codereview/keypair.json
# Or: ZYND_AGENT_PRIVATE_KEY=<base64> (see zyndai README)
ZYND_REGISTRY_URL=https://zns01.zynd.ai
# Public HTTPS base (no path). Local dev: `ngrok http 5000` then paste forwarding URL.
ZYND_ENTITY_URL=https://your-subdomain.ngrok-free.app
# Optional: override bind port (default 5000, must match ngrok target)
# ZYND_SERVER_PORT=5000

# One-shot wire debug: log payload keys + message.content shape on each onMessage (remove after capture).
# ZYND_DEBUG_WIRE=1

# GitHub PAT for the Zynd agent only (never sent by callers). Used to fetch PR title/body/diff from github_url.
# MCP (Cursor): copy `.github/mcp.json` → `.cursor/mcp.json` (or merge into ~/.cursor/mcp.json). GitHub Docker server uses GITHUB_READ_TOKEN via ${env:GITHUB_READ_TOKEN}.
# Public repos: fine-grained read on repo, or classic minimal scope.
# Private PRs: token must have access (e.g. classic `repo`, or fine-grained Contents + Pull requests read).
GITHUB_READ_TOKEN=ghp_your_read_token_here

# Optional: allow Pinecone RAG on public Zynd requests when client sends use_rag: true (default off).
ENABLE_PUBLIC_RAG=0

# --- Zynd MCP (zyndai-mcp-server; see .github/mcp.json) ---
# Optional: Base Sepolia USDC wallet hex key for paid agent calls (x402). Omit for discovery-only.
# ZYNDAI_PAYMENT_PRIVATE_KEY=0x...

# --- Optional / dev ---
NODE_ENV=development
PORT=3000

# Notes:
# - Copy to `.env` and fill real values; never commit `.env`.
# - Registry: https://www.zynd.ai/registry — agent appears after `zynd agent run` + heartbeats.
